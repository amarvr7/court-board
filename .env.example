# Neon Postgres Connection String
DATABASE_URL="postgresql://user:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require"

# 4-Digit Event PIN protecting /board (sets HTTP-only cookie)
EVENT_PIN="2026"

# Password protecting /admin and admin APIs (required — admin is locked if unset)
ADMIN_PASSWORD="change-me-to-a-strong-password"
# Secret used to sign admin session cookies
ADMIN_SESSION_SECRET="generate-with-openssl-rand-hex-32"

# Clerk Auth Credentials for protecting /admin
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_replace_with_your_clerk_key"
CLERK_SECRET_KEY="sk_test_replace_with_your_clerk_key"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
