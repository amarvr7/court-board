# Copy this file to .env.local and fill in real values.
# Never share .env.local or include it in a zip.

# Neon Postgres connection string
DATABASE_URL="postgresql://user:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require"

# 4-digit event PIN for /board. Required — the board stays closed if this is unset.
# Pick a new PIN for each event. Changing it signs every device out of the board.
EVENT_PIN="0000"

# Password for /admin and the admin APIs. Required — admin is locked if unset.
ADMIN_PASSWORD="change-me-to-a-strong-password"

# Secret used to sign the board and admin cookies.
# Generate one with:  openssl rand -hex 32
ADMIN_SESSION_SECRET="generate-with-openssl-rand-hex-32"

# Optional: a separate secret just for board cookies. Falls back to ADMIN_SESSION_SECRET.
# BOARD_SESSION_SECRET=""
